# --- Database (Postgres) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mcp_standards

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of the app (used for OAuth callbacks and MCP connection snippets)
AUTH_URL=http://localhost:3000

# OAuth providers: configure at least one. A provider is enabled when its ID and SECRET are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: restrict Google sign-in to a Workspace domain (e.g. example.com)
AUTH_GOOGLE_HOSTED_DOMAIN=

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated emails bootstrapped as admins on first sign-in
ADMIN_EMAILS=

# --- Tokens ---
# Server-side pepper for token hashing (HMAC-SHA256). Generate with: openssl rand -base64 32
# Rotating it invalidates every existing token.
TOKEN_PEPPER=

# --- MCP ---
# Requests per minute allowed per token
MCP_RATE_LIMIT_PER_MINUTE=120
